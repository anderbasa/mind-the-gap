rules_version = '2';

// Mind the Gap: solo el dueño (un único UID de Google) puede leer o escribir.
// UID de tu cuenta de Google en este proyecto (no es secreto: identifica, no da acceso).
service cloud.firestore {
  match /databases/{database}/documents {
    function esDueno(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid == '50sQgmkiXNdj7R9zehCXcjViLLs2';
    }

    match /users/{uid}/{document=**} {
      allow read, write: if esDueno(uid);
    }

    // Cualquier otra ruta queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
